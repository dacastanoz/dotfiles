#!/usr/bin/python3
"""Shake the pointer to enlarge the cursor for a moment (like macOS shake to locate).

    cursor-shake              run the daemon (started from the Sway config)
    cursor-shake --simulate   play a synthetic shake through the real handler, then
                              idle until the size reverts. Needs no device access.

Enlarging loads a cursor theme, and Sway stalls while it does. A full theme holds many
sizes and animation frames, so at startup this builds a slim copy with one static image
per cursor in ~/.local/share/icons/capitaine-shake. If that fails, it uses the full theme.

Only pointer devices are opened. Each device is classified from sysfs first, so a
keyboard is never opened, and only motion and finger events are read.
"""
import argparse
import glob
import logging
import os
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# ---- Detector tuning. Units are mouse counts, or TOUCHPAD_UNITS_PER_MM on a touchpad.
WINDOW_S = 0.7            # reversals must fall inside this window
MIN_REVERSALS = 4         # direction changes needed to fire
MIN_LEG_TRAVEL = 120      # a stroke shorter than this does not count
MIN_TOTAL_TRAVEL = 600    # combined travel of the counted strokes
MIN_OPPOSITE = 40         # travel the other way before it counts as a reversal
HORIZONTAL_RATIO = 1.5    # a stroke must be this much more horizontal than vertical
MAX_GAP_S = 0.25          # a pause longer than this starts over
TOUCHPAD_UNITS_PER_MM = 10

# ---- Cursor
THEME = "capitaine-cursors"
NORMAL_SIZE = 24
REQUESTED_LARGE_SIZE = 96
HOLD_S = 1.0              # revert after this long without a shake
SEAT = "seat0"
SOURCE_THEME = Path("/usr/share/icons") / THEME
CURSOR_FILE = SOURCE_THEME / "cursors/left_ptr"
SLIM_THEME = Path.home() / ".local/share/icons/capitaine-shake"
XCURSOR_IMAGE = 0xFFFD0002
MAX_CURSOR_SIDE = 0x7FFF  # limit in the Xcursor format

# ---- Daemon
RESCAN_S = 3              # look for new or removed devices
NO_DEVICE_RETRY_S = 30    # retry when nothing is readable

# Linux input event codes (linux/input-event-codes.h).
EV_KEY, EV_REL, EV_ABS = 1, 2, 3
REL_X, REL_Y = 0, 1
ABS_X, ABS_Y = 0, 1
BTN_LEFT = 0x110
BTN_TOOL_FINGER = 0x145
BTN_TOOL_DOUBLETAP = 0x14D
BTN_TOOL_TRIPLETAP = 0x14E
BTN_TOOL_QUADTAP = 0x14F
BTN_TOOL_QUINTTAP = 0x148
MULTI_FINGER = {BTN_TOOL_DOUBLETAP, BTN_TOOL_TRIPLETAP, BTN_TOOL_QUADTAP, BTN_TOOL_QUINTTAP}
# Letter rows of a keyboard: Q..P, A..L, Z..M.
KEYBOARD_KEYS = set(range(16, 26)) | set(range(30, 39)) | set(range(44, 51))

log = logging.getLogger("cursor-shake")


class ShakeDetector:
    """Pure detector. feed() returns True while a shake is in progress."""

    def __init__(self):
        self._reset()
        self._last_t = None

    def _reset(self):
        self._reversals = []  # (time, stroke travel)
        self._direction = 0
        self._leg_x = 0.0
        self._leg_y = 0.0
        self._opposite = 0.0

    def feed(self, t, dx, dy):
        if self._last_t is not None and t - self._last_t > MAX_GAP_S:
            self._reset()
        self._last_t = t

        self._leg_y += abs(dy)
        sign = (dx > 0) - (dx < 0)
        if sign:
            if self._direction == 0:
                self._direction = sign
            if sign == self._direction:
                self._leg_x += abs(dx)
                self._opposite = 0.0
            else:
                self._opposite += abs(dx)
                if self._opposite >= MIN_OPPOSITE:
                    self._close_stroke(t, sign)

        self._reversals = [r for r in self._reversals if t - r[0] <= WINDOW_S]
        return (len(self._reversals) >= MIN_REVERSALS
                and sum(r[1] for r in self._reversals) >= MIN_TOTAL_TRAVEL)

    def _close_stroke(self, t, new_direction):
        if self._leg_x >= MIN_LEG_TRAVEL and self._leg_x >= HORIZONTAL_RATIO * self._leg_y:
            self._reversals.append((t, self._leg_x))
        self._direction = new_direction
        self._leg_x = self._opposite
        self._leg_y = 0.0
        self._opposite = 0.0


class CursorController:
    """Pure state machine: enlarge on shake, revert after `hold` seconds without one."""

    def __init__(self, set_size, normal, large, hold):
        self._set_size = set_size
        self._normal = normal
        self._large = large
        self._hold = hold
        self._enlarged = False
        self._until = 0.0

    def on_shake(self, now):
        self._until = now + self._hold
        if not self._enlarged:
            self._enlarged = True
            self._set_size(self._large)

    def tick(self, now):
        if self._enlarged and now >= self._until:
            self.close()

    def close(self):
        if self._enlarged:
            self._enlarged = False
            self._set_size(self._normal)


class TouchpadTracker:
    """Turn one-finger absolute touchpad positions into millimetre-scaled deltas."""

    def __init__(self, res_x, res_y):
        self._scale_x = TOUCHPAD_UNITS_PER_MM / (res_x or 1)
        self._scale_y = TOUCHPAD_UNITS_PER_MM / (res_y or 1)
        self._finger = False
        self._multi = False
        self._x = self._y = None
        self._last_x = self._last_y = None

    def _forget(self):
        self._x = self._y = None
        self._last_x = self._last_y = None

    def finger(self, down):
        self._finger = down
        self._forget()

    def multi(self, down):
        self._multi = down
        self._forget()

    def abs_x(self, value):
        self._x = value

    def abs_y(self, value):
        self._y = value

    def sync(self):
        """Call on each SYN_REPORT. Returns (dx, dy), or None when there is no movement."""
        if not self._finger or self._multi:
            return None
        delta = None
        if self._last_x is not None or self._last_y is not None:
            dx = dy = 0.0
            if self._x is not None and self._last_x is not None:
                dx = (self._x - self._last_x) * self._scale_x
            if self._y is not None and self._last_y is not None:
                dy = (self._y - self._last_y) * self._scale_y
            delta = (dx, dy)
        if self._x is not None:
            self._last_x = self._x
        if self._y is not None:
            self._last_y = self._y
        return delta


def parse_bitmap(text):
    """Parse a sysfs capability bitmap: hex words, most significant first."""
    bits = set()
    words = text.split()
    for index, word in enumerate(reversed(words)):
        value = int(word, 16)
        bit = 0
        while value:
            if value & 1:
                bits.add(index * 64 + bit)
            value >>= 1
            bit += 1
    return bits


def classify_caps(ev, rel, abs, key):  # noqa: A002 - names match the sysfs files
    """Return "mouse", "touchpad", or None. Anything with letter keys is rejected."""
    keys = parse_bitmap(key)
    if keys & KEYBOARD_KEYS:
        return None
    events = parse_bitmap(ev)
    if EV_REL in events and {REL_X, REL_Y} <= parse_bitmap(rel):
        return "mouse"
    if EV_ABS in events and {ABS_X, ABS_Y} <= parse_bitmap(abs) and BTN_TOOL_FINGER in keys:
        return "touchpad"
    return None


def xcursor_sizes(data):
    """Nominal sizes stored in an Xcursor file."""
    if data[:4] != b"Xcur" or len(data) < 16:
        return set()
    _, _, count = struct.unpack("<III", data[4:16])
    sizes = set()
    for index in range(count):
        entry = data[16 + index * 12:28 + index * 12]
        if len(entry) < 12:
            break
        sizes.add(struct.unpack("<III", entry)[1])
    return sizes


def pick_large_size(available, requested):
    """Largest real size not above the request; the request itself if sizes are unknown."""
    fitting = [size for size in available if size <= requested]
    return max(fitting) if fitting else requested


def _image_entries(data):
    """(nominal size, position) of each image in an Xcursor file."""
    if len(data) < 16 or data[:4] != b"Xcur":
        raise ValueError("not an Xcursor file")
    count = struct.unpack_from("<I", data, 12)[0]
    if 16 + count * 12 > len(data):
        raise ValueError("truncated table of contents")
    entries = []
    for index in range(count):
        kind, size, position = struct.unpack_from("<III", data, 16 + index * 12)
        if kind == XCURSOR_IMAGE:
            entries.append((size, position))
    if not entries:
        raise ValueError("no images")
    return entries


def slim_cursor(data, wanted):
    """An Xcursor file holding only the first image nearest to the wanted size.

    Raises ValueError on malformed data.
    """
    entries = _image_entries(data)
    size = min({s for s, _ in entries}, key=lambda s: (abs(s - wanted), -s))
    position = next(p for s, p in entries if s == size)
    if position + 36 > len(data):
        raise ValueError("image header out of bounds")
    header_size, kind, _, _, width, height = struct.unpack_from("<IIIIII", data, position)
    if kind != XCURSOR_IMAGE or header_size < 36 or not 0 < width <= MAX_CURSOR_SIDE or not 0 < height <= MAX_CURSOR_SIDE:
        raise ValueError("bad image header")
    end = position + header_size + width * height * 4
    if end > len(data):
        raise ValueError("image data out of bounds")
    return (b"Xcur" + struct.pack("<III", 16, 0x10000, 1) + struct.pack("<III", XCURSOR_IMAGE, size, 28)
            + data[position:end])


def _write_slim_cursors(source, target, wanted):
    for entry in sorted(source.iterdir()):
        destination = target / entry.name
        if entry.is_symlink():
            destination.symlink_to(os.readlink(entry))
            continue
        try:
            destination.write_bytes(slim_cursor(entry.read_bytes(), wanted))
        except ValueError as exc:
            log.warning("skipping cursor %s: %s", entry.name, exc)


def build_theme(source, target, wanted):
    """Build the slim theme beside target, then swap it in. Raises OSError or ValueError."""
    target = Path(target)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=f".{target.name}.", dir=target.parent))
    old = None
    try:
        (temporary / "cursors").mkdir()
        _write_slim_cursors(Path(source) / "cursors", temporary / "cursors", wanted)
        if not (temporary / "cursors/left_ptr").is_file():
            raise ValueError("no usable left_ptr cursor")
        (temporary / "index.theme").write_text("[Icon Theme]\nName=Capitaine Shake\n"
                                               "Comment=Built by cursor-shake: one image per cursor\n")
        temporary.chmod(0o755)
        if target.exists():
            old = Path(tempfile.mkdtemp(prefix=f".{target.name}.old.", dir=target.parent))
            target.rename(old / "theme")
        temporary.rename(target)
    finally:
        shutil.rmtree(temporary, ignore_errors=True)
        if old is not None:
            shutil.rmtree(old, ignore_errors=True)


def theme_is_stale(source, target):
    """True when the slim theme is missing or older than anything in the source theme."""
    cursors = Path(source) / "cursors"
    try:
        built = (Path(target) / "cursors").stat().st_mtime
        (Path(target) / "cursors/left_ptr").stat()
    except OSError:
        return True
    newest = max([cursors.stat().st_mtime] + [entry.lstat().st_mtime for entry in cursors.iterdir()])
    return newest > built


def prepare_large_cursor(source, target, wanted):
    """The (theme, size) to enlarge with: the slim theme, or the full one if it can't be built."""
    try:
        if theme_is_stale(source, target):
            build_theme(source, target, wanted)
            log.info("built the slim cursor theme at %s", target)
        return (Path(target).name, wanted)
    except (OSError, ValueError) as exc:
        log.warning("could not build the slim cursor theme, using %s: %s", THEME, exc)
        return (THEME, wanted)


# ---------------------------------------------------------------- system access
def large_size():
    try:
        with open(CURSOR_FILE, "rb") as fh:
            return pick_large_size(xcursor_sizes(fh.read()), REQUESTED_LARGE_SIZE)
    except OSError:
        return REQUESTED_LARGE_SIZE


def set_cursor(cursor):
    theme, size = cursor
    try:
        subprocess.run(["swaymsg", "seat", SEAT, "xcursor_theme", theme, str(size)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        log.warning("could not set the cursor size: %s", exc)


def _read_sysfs(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def pointer_nodes():
    """Map /dev/input/eventN to its kind, using sysfs only: nothing is opened here."""
    nodes = {}
    for directory in glob.glob("/sys/class/input/event*"):
        caps = os.path.join(directory, "device", "capabilities")
        kind = classify_caps(ev=_read_sysfs(f"{caps}/ev"), rel=_read_sysfs(f"{caps}/rel"),
                             abs=_read_sysfs(f"{caps}/abs"), key=_read_sysfs(f"{caps}/key"))
        if kind:
            nodes[f"/dev/input/{os.path.basename(directory)}"] = kind
    return nodes


class Stop(Exception):
    pass


def _raise_stop(signum, _frame):
    raise Stop(signum)


def _compositor_alive():
    sock = os.environ.get("SWAYSOCK")
    return bool(sock) and os.path.exists(sock)


class Device:
    def __init__(self, path, kind, evdev):
        self.dev = evdev.InputDevice(path)
        self.kind = kind
        self.dx = self.dy = 0
        self.tracker = None
        if kind == "touchpad":
            caps = dict(self.dev.capabilities(absinfo=True)).get(EV_ABS, [])
            info = {code: abs_info for code, abs_info in caps}
            self.tracker = TouchpadTracker(info[ABS_X].resolution if ABS_X in info else 0,
                                           info[ABS_Y].resolution if ABS_Y in info else 0)

    def fileno(self):
        return self.dev.fd

    def close(self):
        self.dev.close()

    def handle(self, event):
        """Return (dx, dy) when a full event frame has moved the pointer."""
        if event.type == EV_REL and self.tracker is None:
            if event.code == REL_X:
                self.dx += event.value
            elif event.code == REL_Y:
                self.dy += event.value
        elif event.type == EV_KEY and self.tracker is not None:
            if event.code == BTN_TOOL_FINGER:
                self.tracker.finger(event.value != 0)
            elif event.code in MULTI_FINGER:
                self.tracker.multi(event.value != 0)
        elif event.type == EV_ABS and self.tracker is not None:
            if event.code == ABS_X:
                self.tracker.abs_x(event.value)
            elif event.code == ABS_Y:
                self.tracker.abs_y(event.value)
        elif event.type == 0:  # EV_SYN
            if self.tracker is not None:
                return self.tracker.sync()
            if self.dx or self.dy:
                delta = (self.dx, self.dy)
                self.dx = self.dy = 0
                return delta
        return None


def _sync_devices(devices, evdev):
    """Open newly seen pointer devices and drop vanished ones. Returns True if any is open."""
    wanted = pointer_nodes()
    for path in list(devices):
        if path not in wanted:
            devices.pop(path).close()
    unreadable = []
    for path, kind in wanted.items():
        if path in devices:
            continue
        try:
            devices[path] = Device(path, kind, evdev)
            log.info("reading %s (%s): %s", path, kind, devices[path].dev.name)
        except OSError:
            unreadable.append(path)
    return bool(devices), unreadable


def run_daemon(controller):
    try:
        import evdev
    except ImportError:
        log.error("python-evdev is not installed; the shake gesture is off")
        while _compositor_alive():
            time.sleep(NO_DEVICE_RETRY_S)
        return

    detector = ShakeDetector()
    devices = {}
    next_scan = 0.0
    warned = False
    while _compositor_alive():
        now = time.monotonic()
        if now >= next_scan:
            have_any, unreadable = _sync_devices(devices, evdev)
            if have_any:
                warned = False
                next_scan = now + RESCAN_S
            else:
                if not warned:
                    log.warning("no readable pointer device (%s); see 70-pointer-uaccess.rules. "
                                "Retrying every %d s",
                                ", ".join(unreadable) or "none found", NO_DEVICE_RETRY_S)
                    warned = True
                next_scan = now + NO_DEVICE_RETRY_S
        if not devices:
            time.sleep(min(RESCAN_S, max(0.0, next_scan - now)) or 0.1)
            controller.tick(time.monotonic())
            continue
        ready, _, _ = select.select(list(devices.values()), [], [], 0.2)
        for device in ready:
            try:
                for event in device.dev.read():
                    delta = device.handle(event)
                    if delta and detector.feed(event.timestamp(), *delta):
                        controller.on_shake(time.monotonic())
            except OSError:
                path = device.dev.path
                log.info("device gone: %s", path)
                devices.pop(path, None)
                device.close()
        controller.tick(time.monotonic())
    log.info("compositor is gone; exiting")


def run_simulation(controller, hold):
    """Feed a synthetic shake through the real detector and controller."""
    detector = ShakeDetector()
    start = time.monotonic()
    t, sign, fired = start, 1, False
    for _ in range(10):
        for _ in range(5):
            t += 0.018
            if detector.feed(t, sign * 60, 0):
                controller.on_shake(time.monotonic())
                fired = True
        sign = -sign
    print("fired" if fired else "did not fire", flush=True)
    end = time.monotonic() + hold + 0.5
    while time.monotonic() < end:
        controller.tick(time.monotonic())
        time.sleep(0.05)
    print("idle", flush=True)
    return 0 if fired else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--simulate", action="store_true", help="synthetic shake, no device access")
    parser.add_argument("--hold", type=float, default=HOLD_S, help=argparse.SUPPRESS)
    args = parser.parse_args()
    logging.basicConfig(stream=sys.stderr, level=logging.INFO, format="cursor-shake: %(message)s")

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, _raise_stop)

    normal = (THEME, NORMAL_SIZE)
    large = prepare_large_cursor(SOURCE_THEME, SLIM_THEME, large_size())
    controller = CursorController(set_cursor, normal, large, args.hold)
    try:
        if args.simulate:
            return run_simulation(controller, args.hold)
        set_cursor(normal)  # clear anything left by a previous crash
        run_daemon(controller)
    except Stop:
        pass
    finally:
        # Ignore further signals so the revert cannot be interrupted.
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, signal.SIG_IGN)
        controller.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
