#!/usr/bin/python3
"""Run a command written for Polybar and show its output in a Waybar custom module.

    pango-filter [--json] <command> [args...]

Translates the Polybar %{F#rrggbb}...%{F-} color tags in each output line to Pango
markup, removes other Polybar tags, and escapes everything else. Lines are forwarded
as they arrive, so it also works for commands that keep running.

With --json, for modules with "return-type": "json": valid JSON lines pass through as
they are, and anything else (such as the bar-errors fallback glyph) is converted and
wrapped as JSON with class "error", so Waybar always gets valid input.
"""
import html
import json
import re
import signal
import subprocess
import sys

TAG = re.compile(r"%\{([^}]*)\}")


def convert(line):
    out = []
    pos = 0
    open_span = False
    for match in TAG.finditer(line):
        out.append(html.escape(line[pos:match.start()], quote=False))
        pos = match.end()
        tag = match.group(1)
        if tag.startswith("F#"):
            if open_span:
                out.append("</span>")
            out.append(f'<span color="{html.escape(tag[1:])}">')
            open_span = True
        elif tag == "F-" and open_span:
            out.append("</span>")
            open_span = False
    out.append(html.escape(line[pos:], quote=False))
    if open_span:
        out.append("</span>")
    return "".join(out)


def convert_json(line):
    if line.startswith("{"):
        try:
            json.loads(line)
            return line
        except ValueError:
            pass
    return json.dumps({"text": convert(line), "class": "error"})


def main(argv):
    translate = convert
    if argv and argv[0] == "--json":
        translate = convert_json
        argv = argv[1:]
    if not argv:
        print("usage: pango-filter [--json] <command> [args...]", file=sys.stderr)
        return 2

    # USR1/USR2 wake the wrapped tail scripts, matched with pkill -f, which also
    # matches this process. These must be handlers, not SIG_IGN: an ignored signal
    # stays ignored across exec and the bash script could no longer trap it.
    for signum in (signal.SIGUSR1, signal.SIGUSR2):
        signal.signal(signum, lambda *_: None)

    child = subprocess.Popen(argv, stdout=subprocess.PIPE, text=True, errors="replace", bufsize=1)

    def stop(*_):
        child.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        for line in child.stdout:
            print(translate(line.rstrip("\n")), flush=True)
    except BrokenPipeError:
        child.terminate()
    return child.wait()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
