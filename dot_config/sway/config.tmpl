# Sway config, ported from ~/.config/i3/config.
# Keybindings keep their "# desc:" comments: shortcuts-menu reads them from here.

set $mod Mod4
font pango:Hack 9
floating_modifier $mod normal

# Applied to everything Sway starts, so these reach only this session. session-env does the same for D-Bus and systemd activated services.
set $env env ELECTRON_OZONE_PLATFORM_HINT=auto MOZ_ENABLE_WAYLAND=1 XDG_CURRENT_DESKTOP=sway
set $scripts ~/.config/sway/scripts

#
# Outputs. kanshi (~/.config/kanshi/config) takes over when screens change.
#
# Scale: to change the laptop panel to 1.5, change it here and in the kanshi config.
output eDP-1 scale 1.25
output * bg ~/.config/sway/wallpaper.png fill
seat seat0 xcursor_theme capitaine-cursors 24
# i3's default. Sway's own default is urgent.
focus_on_window_activation smart

#
# Input (was setxkbmap and /etc/X11/xorg.conf.d/30-touuchpad.conf)
#
input type:keyboard {
    xkb_layout latam,us
    # The X server defaults in effect under i3, which no file set.
    repeat_delay 660
    repeat_rate 25
    # Language switch on Caps Lock, disabled under i3 as well. To enable:
    # xkb_layout us,ru
    # xkb_options grp:caps_toggle,grp_led:caps
}
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

# start a terminal
set $term ghostty
# desc: Terminal (ghostty, new tmux session)
bindsym $mod+Return exec $env $term

# kill focused window
bindsym $mod+q kill

# start dmenu (a program launcher)
# desc: Rofi: switch window or run a command
bindsym ctrl+space exec $env rofi -show combi -modi window,run,combi -combi-modi window,run
# App launcher (icons grid/list)
# desc: App launcher (rofi, icons)
bindsym $mod+d exec $env ~/.local/bin/rofi-launcher

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

bindsym $mod+t split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+w sticky toggle

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# Sway has no in-place restart, so this key (i3: restart) reloads too.
# desc: Reload the Sway config (Sway has no in-place restart)
bindsym $mod+Shift+r reload
# Power menu: lock / logout / suspend / reboot / shutdown (asks to confirm)
# desc: Power menu: lock, logout, suspend, reboot, shutdown
bindsym $mod+Shift+e exec $env ~/.local/bin/rofi-powermenu

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

#
# Status Bar (was polybar). Sway restarts it on reload, so there is no launch script.
#
# Sway runs this as a single program name without a shell, so it cannot take "$env"
# arguments or "~". The wrapper sets the same environment.
bar {
    swaybar_command {{ .chezmoi.homeDir }}/.config/sway/scripts/bar
}

# Nord palette (1px borders; the focused window gets a frost-blue border)
# class                 border  backgr. text    indicator child_border
client.focused          #88c0d0 #434c5e #eceff4 #8fbcbb   #88c0d0
client.focused_inactive #4c566a #3b4252 #d8dee9 #4c566a   #4c566a
client.unfocused        #2e3440 #2e3440 #616e88 #2e3440   #2e3440
client.urgent           #bf616a #bf616a #eceff4 #bf616a   #bf616a
client.placeholder      #2e3440 #2e3440 #d8dee9 #2e3440   #2e3440
client.background       #2e3440

########################################################################
####                   Floated windows
########################################################################
# class, instance, window_role and window_type only match XWayland windows, and
# app_id only matches native Wayland ones, so each rule below needs both forms.
# Native dialogs with a parent window float on their own.

# Anchored: an unanchored title regex floats ANY window whose title merely contains
# the word (browser tabs, editors, terminals).
for_window [title="^(Calculator|Timer)$"] floating enable
for_window [class="^.*"] border pixel 1
for_window [app_id="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [app_id="librewolf"] border none
for_window [class="firefox"] border none
for_window [app_id="firefox"] border none
for_window [class="mpv"] floating enable
for_window [app_id="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [app_id="imv"] floating enable
for_window [class="(?i)^zenity$"] floating enable
for_window [app_id="(?i)zenity$"] floating enable
for_window [class="cachyos-welcome"] floating enable
for_window [app_id="(?i)cachyos.?welcome"] floating enable

# Generic dialogs / pop-ups
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
# Chromium-based app windows (PWAs like WhatsApp, --app=URL like Notion) also use
# role "pop-up"; keep them tiled. Real browser pop-ups (instance google-chrome) still float.
# This only concerns Chrome and Brave running through XWayland. Running natively they
# have no role, so no pop-up rule matches and PWAs tile with nothing further to do;
# their native pop-ups tile too unless Chrome marks them as children of a window.
for_window [class="(?i)^(google-chrome|brave-browser|chromium)$" instance="^(crx_.*|.*\..*)$" window_role="pop-up"] floating disable

# System tools
for_window [class="Pavucontrol"] floating enable, resize set 820 560, move position center
for_window [app_id="(?i)pavucontrol$"] floating enable, resize set 820 560, move position center
for_window [class="Blueman-manager"] floating enable, resize set 720 480, move position center
for_window [app_id="(?i)blueman-manager"] floating enable, resize set 720 480, move position center
for_window [class="Nm-connection-editor"] floating enable, move position center
for_window [app_id="(?i)nm-connection-editor"] floating enable, move position center
# wdisplays replaces arandr.
for_window [app_id="(?i)wdisplays"] floating enable, move position center
for_window [class="File-roller"] floating enable
for_window [class="org.gnome.FileRoller"] floating enable
for_window [app_id="(?i)(org\.gnome\.FileRoller|file-roller)"] floating enable
for_window [class="gnome-calculator"] floating enable
for_window [class="org.gnome.Calculator"] floating enable
for_window [app_id="(?i)(org\.gnome\.Calculator|gnome-calculator)"] floating enable
for_window [class="Dragon-drop"] floating enable, sticky enable
for_window [class="Dragon"] floating enable, sticky enable
for_window [app_id="(?i)^dragon(-drop)?$"] floating enable, sticky enable
for_window [class="Thunar" title="^(File Operation Progress|Confirm to replace files|Rename .*|Create New .*|Attention)$"] floating enable
for_window [app_id="(?i)^thunar$" title="^(File Operation Progress|Confirm to replace files|Rename .*|Create New .*|Attention)$"] floating enable

# Media editing: DaVinci Resolve without borders (use $mod+f for fullscreen);
# its secondary windows and dialogs float.
for_window [class="resolve"] border none
for_window [class="resolve" window_type="dialog"] floating enable
for_window [class="resolve" title="^(?!DaVinci Resolve).+"] floating enable
for_window [class="kdenlive" window_type="dialog"] floating enable
for_window [class="Gimp" window_role="(pop-up|task_dialog|gimp-toolbox-color-dialog)"] floating enable

# Window opacity, kept from the picom opacity-rule list. The other picom effects
# (rounded corners, blur, fading, inactive dim) have no equivalent in stock Sway.
for_window [class="TelegramDesktop"] opacity 0.95
for_window [app_id="(?i)telegram"] opacity 0.95
for_window [class="jetbrains-clion"] opacity 0.95
for_window [class="discord"] opacity 0.95
for_window [app_id="(?i)discord"] opacity 0.95
for_window [class="Joplin"] opacity 0.90
for_window [app_id="(?i)joplin"] opacity 0.90

# Do not blank the screen while a fullscreen window is active (xidlehook --not-when-fullscreen).
for_window [all] inhibit_idle fullscreen

########################################################################
####                   HOTKEYS
########################################################################

# Volume with boost up to 250 % and a side bar (wob replaces xob)
bindsym XF86AudioRaiseVolume exec "pamixer --allow-boost --set-limit 250 -ui 5 && pamixer --get-volume > $XDG_RUNTIME_DIR/wob.pipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 5 && pamixer --get-volume > $XDG_RUNTIME_DIR/wob.pipe"

# mute sound
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > $XDG_RUNTIME_DIR/wob.pipe"

# desc: Calculator
bindsym $mod+Shift+p exec $env gnome-calculator
# Displays menu (layout, resolution, UI scale, profiles)
# desc: Displays menu: layout, resolution, UI scale, profiles
bindsym $mod+p exec $env ~/.local/bin/control-center displays
# Old quick cycle (laptop -> extend -> mirror -> external only) kept as fallback
# desc: Quick display cycle: laptop, extend, mirror, external
bindsym $mod+ctrl+p exec $env ~/.local/bin/display-toggle
# desc: Quick display cycle (Fn display key)
bindsym XF86Display exec $env ~/.local/bin/display-toggle

# Control center (Wi-Fi, Bluetooth, airplane, audio, displays, repair)
# desc: Control center: Wi-Fi, Bluetooth, airplane, audio, displays, fix
bindsym $mod+c exec $env ~/.local/bin/control-center
# Active connection details (Wi-Fi password, QR code to share Wi-Fi, IP, DNS)
# desc: Connection details: IP, DNS, Wi-Fi password, QR code
bindsym $mod+i exec $env ~/.local/bin/control-center details
# Audio output / microphone pickers
# desc: Audio output picker
bindsym $mod+Shift+a exec $env ~/.local/bin/control-center audio
# desc: Microphone picker
bindsym $mod+Shift+i exec $env ~/.local/bin/control-center mic
# File manager and Bluetooth manager
# desc: File manager (Thunar)
bindsym $mod+n exec $env thunar
# desc: Bluetooth manager (blueman)
bindsym $mod+b exec $env blueman-manager
# Airplane key: the kernel rfkill handler already toggles the radios; only notify
# desc: Airplane key: show the new radio state
bindsym XF86RFKill exec $env ~/.local/bin/control-center radio-status
# desc: Wi-Fi key: show the new radio state
bindsym XF86WLAN exec $env ~/.local/bin/control-center radio-status

# Media keys
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Notifications
# desc: Close all notifications
bindsym $mod+x exec dunstctl close-all
bindsym $mod+grave exec dunstctl close-all
# desc: Show the last notification again
bindsym $mod+Shift+grave exec dunstctl history-pop

# desc: Lock screen
bindsym $mod+l exec "sleep 0.1 && $scripts/lock"

# desc: Switch keyboard layout (latam / us)
bindsym Mod1+Shift+space input type:keyboard xkb_switch_layout next

# Screenshots (grim + slurp replace maim, wl-copy replaces xclip)
# desc: Screenshot of an area, copied to the clipboard
bindsym Print exec ~/.config/sway/scripts/screenshot-area
# desc: Screenshot of the full screen, saved to ~/Pictures/Screenshots
bindsym Shift+Print exec "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send 'Screenshot saved'"

# Brightness with an indicator bar (wob replaces xob)
bindsym XF86MonBrightnessUp exec "brightnessctl set +5% && brightnessctl -m | cut -d, -f4 | tr -d % > $XDG_RUNTIME_DIR/wob.pipe"
bindsym XF86MonBrightnessDown exec "brightnessctl set 5%- && brightnessctl -m | cut -d, -f4 | tr -d % > $XDG_RUNTIME_DIR/wob.pipe"

# --- Gentleman toolkit (terminal workflows, all in ghostty) ---
# Persistent tmux session "main": attach if it exists, create it otherwise.
# desc: Terminal attached to the persistent tmux session "main"
bindsym $mod+Shift+Return exec $env ghostty -e tmux new-session -A -s main
# (width/height=0 lets the rule below size the popup instead of the ghostty 100x100-cell default.)
# lazygit (opens the recent-repos picker when started outside a repo) and yazi as floating popups.
# desc: lazygit popup (recent repos outside a repo)
bindsym $mod+g exec $env ghostty --class=dev.gentleman.popup --window-width=0 --window-height=0 --title=lazygit -e lazygit
# desc: yazi file manager popup
bindsym $mod+y exec $env ghostty --class=dev.gentleman.popup --window-width=0 --window-height=0 --title=yazi -e yazi
# Temperature / system monitor (btop, live CPU/temp graphs) as a floating popup (T19).
# desc: Temperature / system monitor (btop, floating)
bindsym $mod+Shift+t exec $env ~/.config/waybar/scripts/temperature.sh --monitor
# desc: Battery menu (health, 80 % charge limit, power profile, calibration)
bindsym $mod+Shift+b exec $env ~/.local/bin/control-center battery
# Neovim quick-open: pick a project with zoxide + fzf, then open nvim there.
# desc: Neovim quick-open: pick a project (zoxide + fzf)
bindsym $mod+o exec $env ghostty --title=nvim -e nvim-project
# Shortcuts / help menu: searchable list of every shortcut and command (runs the selection).
# desc: Shortcuts / help menu (this list)
bindsym $mod+F1 exec $env ~/.local/bin/shortcuts-menu
for_window [app_id="^dev\.gentleman\.popup$"] floating enable, resize set 80 ppt 80 ppt, move position center
for_window [class="^dev\.gentleman\.popup$"] floating enable, resize set 80 ppt 80 ppt, move position center

# Touchpad gestures
# desc: Three-finger swipe left: next workspace on this screen
bindgesture swipe:3:left workspace next_on_output
# desc: Three-finger swipe right: previous workspace on this screen
bindgesture swipe:3:right workspace prev_on_output
# desc: Three-finger swipe up: fullscreen (toggle)
bindgesture swipe:3:up fullscreen toggle
# desc: Four-finger swipe up: control center
bindgesture swipe:4:up exec $env ~/.local/bin/control-center

# Apps still running with no window (same picker as a left click on the bar module)
# desc: Background apps: list, and stop one
bindsym $mod+Shift+j exec $env $scripts/bg-apps --menu

########################################################################
####                   AUTOLOAD
########################################################################
# Lines starting with "exec" are the session's autostarts. The nested test config
# is generated from this file by dropping exactly those lines.

# Export the session environment to D-Bus/systemd user services FIRST, before
# anything that may D-Bus-activate a service. It stays running to undo this when
# Sway exits: the user manager lingers, so these values would otherwise outlive the session.
exec $env $scripts/session-env

exec $env swaymsg 'workspace number 1; exec $env ghostty'

exec $env dunst
# redshift is not installed (and needs a manual lat:lon since Mozilla geolocation is gone).
# It does not support Sway; for a night light, install gammastep and use:
#exec gammastep -l <lat>:<lon>
# Monitor profiles. Replaces autorandr. On reload, keep the running kanshi.
exec_always sh -c 'if pgrep -x kanshi >/dev/null; then kanshictl reload; else exec kanshi; fi'
# Same as i3: user autostart dir first so it overrides the system entries. The Sway
# dir comes before it and disables autorandr and picom, and gives nm-applet --indicator.
# nm-applet and blueman-applet start from /etc/xdg/autostart via dex.
exec $env dex -a -s ~/.config/sway/autostart/:~/.config/autostart/:/etc/xdg/autostart/
exec $env udiskie --smart-tray --appindicator --automount --notify
exec $env /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# --- Power management: only blank the screen on idle, never suspend ---
# Turn the screen off after 10 min idle (the fullscreen exception is the inhibit_idle
# rule above). As in i3, nothing locks automatically, and sleep targets stay masked.
exec swayidle -w timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'

# Volume/brightness OSD: idempotent, safe on reload
exec_always $scripts/osd-start

# Shake the pointer to enlarge the cursor. Logs to the journal: journalctl -t cursor-shake
exec systemd-cat -t cursor-shake $scripts/cursor-shake
