set $mod Mod4
font pango:Hack 9
floating_modifier $mod

# start a terminal
set $term ghostty
# desc: Terminal (ghostty, new tmux session)
bindsym $mod+Return exec $term

# kill focused window
bindsym $mod+q kill

# start dmenu (a program launcher)
#bindsym ctrl+space exec rofi -show run
# desc: Rofi: switch window or run a command
bindsym ctrl+space exec "rofi -show combi -modi window,run,combi -combi-modi window,run"
# App launcher (icons grid/list)
# desc: App launcher (rofi, icons)
bindsym $mod+d exec --no-startup-id ~/.local/bin/rofi-launcher
#bindsym ctrl+space exec dmenu_run

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

bindsym $mod+t split toggle

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+w sticky toggle

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
# Power menu: lock / logout / suspend / reboot / shutdown (asks to confirm)
# desc: Power menu: lock, logout, suspend, reboot, shutdown
bindsym $mod+Shift+e exec --no-startup-id ~/.local/bin/rofi-powermenu

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"


#
# Status Bar:
#
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Nord palette (1px borders; the focused window gets a frost-blue border)
# class                 border  backgr. text    indicator child_border
client.focused          #88c0d0 #434c5e #eceff4 #8fbcbb   #88c0d0
client.focused_inactive #4c566a #3b4252 #d8dee9 #4c566a   #4c566a
client.unfocused        #2e3440 #2e3440 #616e88 #2e3440   #2e3440
client.urgent           #bf616a #bf616a #eceff4 #bf616a   #bf616a
client.placeholder      #2e3440 #2e3440 #d8dee9 #2e3440   #2e3440
client.background       #2e3440

########################################################################
########################################################################
####
####                   Workplaces layout
####
########################################################################
########################################################################

exec --no-startup-id "i3-msg 'workspace 1; exec ghostty'"

########################################################################
########################################################################
####
####                   Floated windows
####
########################################################################
########################################################################

# Anchored: an unanchored title regex floats ANY window whose title merely contains
# the word (browser tabs, editors, terminals).
for_window [title="^(Calculator|Timer)$"] floating enable
for_window [class="^.*"] border pixel 1
for_window [class="librewolf"] border none
for_window [class="firefox"] border none
for_window [class="mpv"] floating enable
for_window [class="imv"] floating enable
for_window [class="feh" title="^Wi-Fi QR code$"] floating enable, move position center
for_window [class="(?i)^zenity$"] floating enable
for_window [class="cachyos-welcome"] floating enable

# Generic dialogs / pop-ups
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
# Chromium-based app windows (PWAs like WhatsApp, --app=URL like Notion) also use
# role "pop-up"; keep them tiled. Real browser pop-ups (instance google-chrome) still float.
for_window [class="(?i)^(google-chrome|brave-browser|chromium)$" instance="^(crx_.*|.*\..*)$" window_role="pop-up"] floating disable

# System tools
for_window [class="Pavucontrol"] floating enable, resize set 820 560, move position center
for_window [class="Blueman-manager"] floating enable, resize set 720 480, move position center
for_window [class="Nm-connection-editor"] floating enable, move position center
for_window [class="Arandr"] floating enable, move position center
for_window [class="File-roller"] floating enable
for_window [class="org.gnome.FileRoller"] floating enable
for_window [class="gnome-calculator"] floating enable
for_window [class="org.gnome.Calculator"] floating enable
for_window [class="Dragon-drop"] floating enable, sticky enable
for_window [class="Dragon"] floating enable, sticky enable
for_window [class="Thunar" title="^(File Operation Progress|Confirm to replace files|Rename .*|Create New .*|Attention)$"] floating enable

# Media editing: DaVinci Resolve without borders (use $mod+f for fullscreen);
# its secondary windows and dialogs float.
for_window [class="resolve"] border none
for_window [class="resolve" window_type="dialog"] floating enable
for_window [class="resolve" title="^(?!DaVinci Resolve).+"] floating enable
for_window [class="kdenlive" window_type="dialog"] floating enable
for_window [class="Gimp" window_role="(pop-up|task_dialog|gimp-toolbox-color-dialog)"] floating enable


########################################################################
########################################################################
####
####                   HOTKEYS
####
########################################################################
########################################################################


#bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
#bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"

# Control de volumen con sobreamplificación al 250% y barra lateral
bindsym XF86AudioRaiseVolume exec --no-startup-id "pamixer --allow-boost --set-limit 250 -ui 5 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec --no-startup-id "pamixer -ud 5 && pamixer --get-volume > /tmp/xobpipe"

# mute sound
bindsym XF86AudioMute exec --no-startup-id "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"

# desc: Calculator
bindsym $mod+Shift+p exec gnome-calculator
# Displays menu (layout, resolution, UI scale, profiles)
# desc: Displays menu: layout, resolution, UI scale, profiles
bindsym $mod+p exec --no-startup-id ~/.local/bin/control-center displays
# Old quick cycle (laptop -> extend -> mirror -> external only) kept as fallback
# desc: Quick display cycle: laptop, extend, mirror, external
bindsym $mod+ctrl+p exec --no-startup-id ~/.local/bin/display-toggle
# desc: Quick display cycle (Fn display key)
bindsym XF86Display exec --no-startup-id ~/.local/bin/display-toggle

# Control center (Wi-Fi, Bluetooth, airplane, audio, displays, repair)
# desc: Control center: Wi-Fi, Bluetooth, airplane, audio, displays, fix
bindsym $mod+c exec --no-startup-id ~/.local/bin/control-center
# Active connection details (Wi-Fi password, QR code to share Wi-Fi, IP, DNS)
# desc: Connection details: IP, DNS, Wi-Fi password, QR code
bindsym $mod+i exec --no-startup-id ~/.local/bin/control-center details
# Audio output / microphone pickers
# desc: Audio output picker
bindsym $mod+Shift+a exec --no-startup-id ~/.local/bin/control-center audio
# desc: Microphone picker
bindsym $mod+Shift+i exec --no-startup-id ~/.local/bin/control-center mic
# File manager and Bluetooth manager
# desc: File manager (Thunar)
bindsym $mod+n exec --no-startup-id thunar
{{ if .hasBluetooth -}}
# desc: Bluetooth manager (blueman)
bindsym $mod+b exec --no-startup-id blueman-manager
{{ end -}}
# Airplane key: the kernel rfkill handler already toggles the radios; only notify
# desc: Airplane key: show the new radio state
bindsym XF86RFKill exec --no-startup-id ~/.local/bin/control-center radio-status
# desc: Wi-Fi key: show the new radio state
bindsym XF86WLAN exec --no-startup-id ~/.local/bin/control-center radio-status

# Media keys
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Notifications
# desc: Close all notifications
bindsym $mod+grave exec --no-startup-id dunstctl close-all
# desc: Show the last notification again
bindsym $mod+Shift+grave exec --no-startup-id dunstctl history-pop

## This will switch the current layout to the 'us'.
#bindsym $mod+l exec "setxkbmap -layout us && sleep 0.1 && setxkbmap -option grp:caps_toggle 'us,ru' -option grp_led:caps && sleep 0.1 && i3lock --blur 5"

## This keybind will lock the screen. The lockscreen.
# desc: Lock screen
bindsym $mod+l exec --no-startup-id "sleep 0.1 && i3lock --blur 5"

########################################################################
########################################################################
####
####                   AUTOLOAD
####
########################################################################
########################################################################

## Here is a language switcher by pressing capslock button,
## and the capslock functionality available by using shift+capslock.
## Uncomment to enable 'us' to/from 'ru' switch. change to language(s) you prefer more.

#exec_always setxkbmap -option grp:caps_toggle "us,ru" -option "grp:caps_toggle,grp_led:caps"

# Export the X session environment to D-Bus/systemd user services (keyring, notifications,
# portals) FIRST, before anything that may D-Bus-activate a service without DISPLAY.
exec --no-startup-id dbus-update-activation-environment --systemd --all

# Monitor layout at login is applied by autorandr (~/.config/autostart/autorandr.desktop);
# a hardcoded xrandr call here would race with it.
#exec --no-startup-id xrandr --output HDMI-A-0 --auto --right-of eDP 2>/dev/null

exec --no-startup-id feh --bg-fill ~/.config/i3/wallpaper.png

exec --no-startup-id dunst
exec --no-startup-id picom
# redshift is not installed (and needs a manual lat:lon since Mozilla geolocation is gone):
# install it and use e.g. `redshift -l <lat>:<lon>` to re-enable a night light.
#exec --no-startup-id redshift
# User autostart dir first so ~/.config/autostart overrides (e.g. autorandr).
# nm-applet and blueman-applet start from /etc/xdg/autostart via dex.
exec --no-startup-id dex -a -s ~/.config/autostart/:/etc/xdg/autostart/
exec --no-startup-id udiskie --smart-tray --automount --notify
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# --- Power management: only blank the screen on idle, never suspend ---
# Disable X's built-in screensaver/DPMS timer; xidlehook drives the screen off instead
exec_always --no-startup-id xset s off -dpms
# Turn the screen off after 10 min idle, UNLESS a fullscreen window is active (VLC, etc.)
exec_always --no-startup-id sh -c "pkill -x xidlehook; xidlehook --not-when-fullscreen --timer 600 'xset dpms force off' ''"

# Volume/brightness OSD (xob): idempotent, safe on reload
exec_always --no-startup-id ~/.local/bin/xob-start
#exec ~/.i3/launch.sh
exec --no-startup-id setxkbmap latam
# desc: Switch keyboard layout (latam / us)
bindsym Mod1+Shift+space exec --no-startup-id bash -c "setxkbmap -query | grep -q latam && setxkbmap us || setxkbmap latam"
# Screenshots with maim
# desc: Screenshot of an area, copied to the clipboard
bindsym Print exec --no-startup-id "maim -s | xclip -selection clipboard -t image/png && notify-send 'Screenshot copied to clipboard'"
# desc: Screenshot of the full screen, saved to ~/Pictures/Screenshots
bindsym Shift+Print exec --no-startup-id "maim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send 'Screenshot saved'"

# Control de brillo con barra indicadora (xob)
bindsym XF86MonBrightnessUp exec --no-startup-id "brightnessctl set +5% && brightnessctl -m | cut -d, -f4 | tr -d % > /tmp/xobpipe"
bindsym XF86MonBrightnessDown exec --no-startup-id "brightnessctl set 5%- && brightnessctl -m | cut -d, -f4 | tr -d % > /tmp/xobpipe"

# gnome-keyring-daemon is started and unlocked automatically by PAM via ly (display manager)
# Do NOT start it here -- that would replace the already-unlocked daemon with a locked one
# (The X session environment is exported to D-Bus/systemd at the top of AUTOLOAD.)

# --- Gentleman toolkit (terminal workflows, all in ghostty) ---
# Persistent tmux session "main": attach if it exists, create it otherwise.
# desc: Terminal attached to the persistent tmux session "main"
bindsym $mod+Shift+Return exec --no-startup-id ghostty -e tmux new-session -A -s main
# (width/height=0 lets the i3 rule size the popup instead of the ghostty 100x100-cell default.)
# lazygit (opens the recent-repos picker when started outside a repo) and yazi as floating popups.
# desc: lazygit popup (recent repos outside a repo)
bindsym $mod+g exec --no-startup-id ghostty --class=dev.gentleman.popup --window-width=0 --window-height=0 --title=lazygit -e lazygit
# desc: yazi file manager popup
bindsym $mod+y exec --no-startup-id ghostty --class=dev.gentleman.popup --window-width=0 --window-height=0 --title=yazi -e yazi
# Temperature / system monitor (btop, live CPU/temp graphs) as a floating popup (T19).
# desc: Temperature / system monitor (btop, floating)
bindsym $mod+Shift+t exec --no-startup-id ~/.config/polybar/scripts/temperature.sh --monitor
{{ if .hasBattery -}}
# desc: Battery menu (health, 80 % charge limit, power profile, calibration)
bindsym $mod+Shift+b exec --no-startup-id ~/.local/bin/control-center battery
{{ end -}}
# Neovim quick-open: pick a project with zoxide + fzf, then open nvim there.
# desc: Neovim quick-open: pick a project (zoxide + fzf)
bindsym $mod+o exec --no-startup-id ghostty --title=nvim -e nvim-project
# Shortcuts / help menu: searchable list of every shortcut and command (runs the selection).
# desc: Shortcuts / help menu (this list)
bindsym $mod+F1 exec --no-startup-id ~/.local/bin/shortcuts-menu
for_window [class="^dev\.gentleman\.popup$"] floating enable, resize set 80 ppt 80 ppt, move position center
