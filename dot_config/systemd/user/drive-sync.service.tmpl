[Unit]
Description=Bidirectional sync of Google Drive with rclone bisync
Documentation=file://{{ .chezmoi.homeDir }}/.local/bin/drive-sync
# User managers cannot order against the system network-online.target;
# the script itself checks connectivity and skips gracefully when offline.

[Service]
Type=oneshot
ExecStart=%h/.local/bin/drive-sync
Environment=DRIVE_SYNC_TIMER=1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
MemoryHigh=1G
# No limit on the whole run: a large upload that is moving must not be killed. The script has a
# per-remote watchdog for runs that stop making progress.
TimeoutStartSec=infinity
# Records a run the service manager or the kernel killed (OOM, signal), which the script cannot.
ExecStopPost=%h/.local/bin/drive-sync --post-stop
# A killed run leaves a bisync lock; --max-lock 2m + --recover handle it next time.
KillMode=mixed
