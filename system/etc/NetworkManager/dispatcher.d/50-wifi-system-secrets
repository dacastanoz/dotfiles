#!/bin/bash
# NetworkManager dispatcher: when a Wi-Fi profile comes up, make it usable before login.
#   - drops per-user permissions (profile becomes system-wide)
#   - stores the PSK in the profile (psk-flags=0) when NetworkManager already has it
# Only PSK/SAE/OWE/open networks are touched; 802.1X (enterprise) profiles are never changed.
# Lossless: if the secret is not available to root, the flags are left as they are.
set -u

[ "${2:-}" = up ] || exit 0
uuid=${CONNECTION_UUID:-}
[ -n "$uuid" ] || exit 0

get() { nmcli -t -g "$1" connection show uuid "$uuid" 2>/dev/null; }

[ "$(get connection.type)" = 802-11-wireless ] || exit 0

keymgmt=$(get 802-11-wireless-security.key-mgmt)
case "$keymgmt" in
    ""|wpa-psk|sae|owe) ;;
    *) exit 0 ;; # enterprise / WEP: leave alone
esac

args=()
if [ -n "$(get connection.permissions)" ]; then
    args+=(connection.permissions "")
fi

if [ "$keymgmt" = wpa-psk ] || [ "$keymgmt" = sae ]; then
    flags=$(get 802-11-wireless-security.psk-flags)
    case "$flags" in
        0|0\ *) ;; # already stored in the profile
        *)
            psk=$(nmcli -s -t -g 802-11-wireless-security.psk connection show uuid "$uuid" 2>/dev/null)
            if [ -n "$psk" ]; then
                args+=(802-11-wireless-security.psk-flags 0 802-11-wireless-security.psk "$psk")
            fi
            unset psk
            ;;
    esac
fi

[ "${#args[@]}" -gt 0 ] || exit 0
nmcli connection modify uuid "$uuid" "${args[@]}" >/dev/null 2>&1 \
    && logger -t wifi-system-secrets "made Wi-Fi profile $uuid system-wide"
exit 0
