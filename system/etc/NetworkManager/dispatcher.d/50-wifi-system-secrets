#!/bin/bash
# Safety net: make newly joined personal Wi-Fi profiles (WPA-PSK / SAE / open) system-wide
# with system-stored secrets, so they auto-connect at boot before login and never
# depend on the user keyring. Enterprise (802.1X/EAP) profiles are never touched.
# Only rewrites a profile when the secret is actually retrievable (lossless).
# Installed 2026-09-28 (laptop-desktop-setup T14).

# shellcheck disable=SC2153 # CONNECTION_ID/CONNECTION_UUID are set by NetworkManager
[ "$2" = "up" ] || exit 0
[ -n "${CONNECTION_UUID:-}" ] || exit 0

get() { nmcli -t -g "$1" connection show "$CONNECTION_UUID" 2>/dev/null; }

[ "$(get connection.type)" = "802-11-wireless" ] || exit 0
keymgmt=$(get 802-11-wireless-security.key-mgmt)
case "$keymgmt" in
    wpa-psk|sae|"") ;;
    *) exit 0 ;; # wpa-eap, owe, etc.: leave untouched
esac

perms=$(get connection.permissions)
flags=$(get 802-11-wireless-security.psk-flags)
flags=${flags%% *}
[ -z "$perms" ] && { [ -z "$flags" ] || [ "$flags" = "0" ]; } && exit 0

if [ -z "$keymgmt" ]; then
    # Open network: no secret to preserve.
    nmcli connection modify "$CONNECTION_UUID" connection.permissions "" \
        && logger -t nm-wifi-secrets "made open profile '$CONNECTION_ID' system-wide"
    exit 0
fi

psk=$(nmcli -s -t -g 802-11-wireless-security.psk connection show "$CONNECTION_UUID" 2>/dev/null)
if [ -n "$psk" ]; then
    nmcli connection modify "$CONNECTION_UUID" connection.permissions "" \
        802-11-wireless-security.psk-flags 0 802-11-wireless-security.psk "$psk" \
        && logger -t nm-wifi-secrets "moved '$CONNECTION_ID' to system-wide profile with system-stored secret"
else
    logger -t nm-wifi-secrets "'$CONNECTION_ID' has agent-owned/user-only secret that root cannot read; left unchanged"
fi
exit 0
