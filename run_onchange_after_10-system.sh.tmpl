#!/bin/bash
# Apply root-level configuration from the repo's system/ tree (idempotent).
# Every overwritten file is backed up once as <file>.bak-chezmoi. The network is never restarted.
# Re-runs when anything under system/ (or the detected hardware) changes:
{{- range (glob (joinPath .chezmoi.sourceDir "system/**/*")) }}
{{- if not (stat .).isDir }}
#   {{ trimPrefix (joinPath $.chezmoi.sourceDir "system") . }} {{ include . | sha256sum | trunc 16 }}
{{- end }}
{{- end }}
#   hardware: battery={{ .hasBattery }} wifi={{ .hasWifi }} bt={{ .hasBluetooth }} ryzen={{ .hasRyzen }} amdgpu={{ .hasAMDGPU }} sensor={{ .cpuSensor }} acer={{ .isAcerLaptop }}
set -euo pipefail

SYS={{ joinPath .chezmoi.sourceDir "system" | quote }}
HAS_BATTERY={{ .hasBattery }}
HAS_WIFI={{ .hasWifi }}
HAS_BLUETOOTH={{ .hasBluetooth }}
HAS_RYZEN={{ .hasRyzen }}
IS_AMD_LAPTOP={{ .isAMDLaptop }}
HAS_AMDGPU={{ .hasAMDGPU }}
CPU_SENSOR={{ .cpuSensor | quote }}
IS_ACER_LAPTOP={{ .isAcerLaptop }}

changed=()   # files written
enabled=()   # units enabled
skipped=()   # features skipped (with reason)
reboot=()    # things that only take effect after a reboot

say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
has() { command -v "$1" >/dev/null 2>&1; }

say "sudo is needed to apply system configuration (system/ tree)"
sudo -v

# install_sys <path under system/> [mode] : copy to /<path> if different, backing up the old file.
install_sys() {
    local rel=$1 mode=${2:-0644} src dst
    src="$SYS/$rel"
    dst="/$rel"
    if sudo test -f "$dst" && sudo cmp -s "$src" "$dst"; then
        return 1
    fi
    if sudo test -f "$dst" && ! sudo test -e "$dst.bak-chezmoi"; then
        sudo cp -a "$dst" "$dst.bak-chezmoi"
    fi
    sudo install -D -m "$mode" -o root -g root "$src" "$dst"
    changed+=("$dst")
    return 0
}

# write_sys <dst> <mode> : write stdin to <dst> if different (with backup).
write_sys() {
    local dst=$1 mode=$2 tmp
    tmp=$(mktemp)
    cat >"$tmp"
    if sudo test -f "$dst" && sudo cmp -s "$tmp" "$dst"; then rm -f "$tmp"; return 1; fi
    if sudo test -f "$dst" && ! sudo test -e "$dst.bak-chezmoi"; then sudo cp -a "$dst" "$dst.bak-chezmoi"; fi
    sudo install -D -m "$mode" -o root -g root "$tmp" "$dst"
    rm -f "$tmp"
    changed+=("$dst")
}

enable_unit() { # enable_unit <unit> [--now]
    if systemctl list-unit-files "$1" >/dev/null 2>&1 && systemctl cat "$1" >/dev/null 2>&1; then
        if ! systemctl is-enabled --quiet "$1" 2>/dev/null; then
            sudo systemctl enable "$@" >/dev/null 2>&1 && enabled+=("$1")
        fi
    fi
}

# ini_set <file> <section> <key> <value> : set key=value inside [section] (uncomments/overrides).
ini_set() {
    local file=$1 section=$2 key=$3 value=$4 tmp
    tmp=$(mktemp)
    awk -v sec="[$section]" -v key="$key" -v val="$value" '
        function flush() { if (insec && !done) { print key " = " val; done = 1 } }
        /^\[.*\]/ { flush(); insec = ($0 == sec) }
        insec && !done && $0 ~ "^[#[:space:]]*" key "[[:space:]]*=" {
            if ($0 ~ "^" key "[[:space:]]*=[[:space:]]*" val "[[:space:]]*$") print; else print key " = " val
            done = 1; next
        }
        { print }
        END { flush(); if (!done) { print ""; print sec; print key " = " val } }
    ' "$file" >"$tmp"
    if ! sudo cmp -s "$tmp" "$file"; then
        sudo test -e "$file.bak-chezmoi" || sudo cp -a "$file" "$file.bak-chezmoi"
        sudo install -m 0644 -o root -g root "$tmp" "$file"
        changed+=("$file [$section] $key")
    fi
    rm -f "$tmp"
}

# ---------------------------------------------------------------- memory, logs, freeze resilience
install_sys etc/sysctl.d/99-zram-extra.conf && sudo sysctl -q -p /etc/sysctl.d/99-zram-extra.conf || true
install_sys etc/sysctl.d/90-freeze-resilience.conf && sudo sysctl -q -p /etc/sysctl.d/90-freeze-resilience.conf || true
install_sys etc/systemd/system/session-.scope.d/50-oomd-avoid.conf || true
if install_sys etc/systemd/journald.conf.d/90-persistent-size.conf; then
    sudo systemctl restart systemd-journald || warn "journald restart failed"
fi
enable_unit systemd-pstore.service || true

# ---------------------------------------------------------------- hardware watchdog (AMD sp5100_tco)
watchdog_ok=false
if [ "$HAS_RYZEN" = true ] && modinfo sp5100_tco >/dev/null 2>&1; then
    if lsmod | grep -q '^sp5100_tco' || sudo modprobe sp5100_tco 2>/dev/null; then
        if ls /dev/watchdog0 >/dev/null 2>&1; then
            watchdog_ok=true
        fi
    fi
fi
if [ "$watchdog_ok" = true ]; then
    # cachyos-settings blacklists sp5100_tco in /usr/lib/modprobe.d/blacklist.conf; the same
    # file name in /etc wins, so mirror it without that line.
    if [ -f /usr/lib/modprobe.d/blacklist.conf ]; then
        blacklist=$(
            echo "# Generated by dotfiles (run_onchange_after_10-system): mirrors"
            echo "# /usr/lib/modprobe.d/blacklist.conf WITHOUT sp5100_tco (hardware watchdog)."
            echo "# To revert: delete this file (and /etc/modules-load.d/sp5100_tco.conf)."
            sed -e '/sp5100_tco/d' -e '/^#/d' -e '/^$/d' /usr/lib/modprobe.d/blacklist.conf
        )
        write_sys /etc/modprobe.d/blacklist.conf 0644 <<<"$blacklist" && reboot+=("sp5100_tco autoload") || true
    fi
    install_sys etc/modules-load.d/sp5100_tco.conf && reboot+=("sp5100_tco autoload") || true
    install_sys etc/systemd/system.conf.d/90-watchdog.conf && reboot+=("systemd hardware watchdog (or: sudo systemctl daemon-reexec)") || true
    install_sys etc/systemd/system/watchdog-suspend.service || true
else
    skipped+=("hardware watchdog: no working sp5100_tco (AMD Ryzen only)")
fi

# ---------------------------------------------------------------- thermal protection
if [ "$CPU_SENSOR" = k10temp ]; then
    install_sys usr/local/bin/thermal-guard 0755 || true
    install_sys etc/systemd/system/thermal-guard.service || true
else
    skipped+=("thermal-guard: needs an AMD k10temp sensor (found '${CPU_SENSOR:-none}')")
fi
if [ "$IS_AMD_LAPTOP" = true ] && has ryzenadj; then
    install_sys usr/local/bin/ryzenadj-apply 0755 || true
    install_sys etc/systemd/system/ryzenadj.service || true
    install_sys etc/systemd/system/ryzenadj.timer || true
else
    skipped+=("ryzenadj limits: only on AMD Ryzen laptops with ryzenadj installed")
fi

# ---------------------------------------------------------------- battery care (laptops)
if [ "$HAS_BATTERY" = true ]; then
    install_sys usr/local/bin/battery-care 0755 || true
    # The config holds the user's choices (charge limit, profiles): only install it once.
    sudo test -f /etc/battery-care.conf || install_sys etc/battery-care.conf || true
    install_sys etc/systemd/system/battery-care.service || true
    install_sys etc/systemd/system/battery-care-ac.service || true
    if install_sys etc/udev/rules.d/99-battery-care.rules; then
        sudo udevadm control --reload || true
    fi
    install_sys usr/share/polkit-1/actions/org.local.battery-care.policy || true
    install_sys etc/polkit-1/rules.d/50-battery-care.rules || true
    if [ "$IS_ACER_LAPTOP" = true ]; then
        install_sys etc/modules-load.d/acer-wmi-battery.conf || true
        if modinfo acer_wmi_battery >/dev/null 2>&1; then
            sudo modprobe acer_wmi_battery 2>/dev/null || warn "acer_wmi_battery did not load (model not supported?)"
        else
            skipped+=("80 % charge limit: acer-wmi-battery-dkms not installed")
        fi
    else
        skipped+=("80 % charge limit: Acer only (auto power profile still active)")
    fi
else
    skipped+=("battery care: no battery")
fi

# ---------------------------------------------------------------- network (never restarted)
if [ "$HAS_WIFI" = true ] && [ -d /etc/NetworkManager ]; then
    install_sys etc/NetworkManager/conf.d/wifi-powersave.conf && reboot+=("Wi-Fi powersave off (or next NetworkManager restart)") || true
    install_sys etc/NetworkManager/dispatcher.d/50-wifi-system-secrets 0700 || true
    if lsmod | grep -q '^mt7921e'; then
        install_sys etc/modprobe.d/mt7921e.conf && reboot+=("mt7921e ASPM off") || true
    fi
else
    skipped+=("Wi-Fi tweaks: no wireless interface")
fi

# ---------------------------------------------------------------- Bluetooth (main.conf has no drop-in dir)
if [ "$HAS_BLUETOOTH" = true ] && [ -f /etc/bluetooth/main.conf ]; then
    ini_set /etc/bluetooth/main.conf General FastConnectable true
    ini_set /etc/bluetooth/main.conf General Experimental true
    ini_set /etc/bluetooth/main.conf Policy AutoEnable true
elif [ "$HAS_BLUETOOTH" = true ]; then
    skipped+=("Bluetooth main.conf: /etc/bluetooth/main.conf missing (install bluez)")
else
    skipped+=("Bluetooth: no adapter")
fi

# ---------------------------------------------------------------- displays
if has autorandr; then
    install_sys etc/systemd/system/autorandr.service.d/override.conf || true
fi

# ---------------------------------------------------------------- kernel command line (limine)
if [ -f /etc/default/limine ]; then
    want=(efi_pstore.pstore_disable=0)
    [ "$HAS_AMDGPU" = true ] && want+=(amdgpu.gpu_recovery=1)
    tmp=$(mktemp)
    cat /etc/default/limine >"$tmp"
    for tok in "${want[@]}"; do
        if ! grep -q "^KERNEL_CMDLINE\[default\].*[\" ]${tok//./\\.}[\" ]" "$tmp"; then
            sed -i -E "/^KERNEL_CMDLINE\[default\]/ s/\"$/ ${tok}\"/" "$tmp"
        fi
    done
    if [ "$watchdog_ok" = true ]; then
        sed -i -E '/^KERNEL_CMDLINE\[default\]/ { s/([" ])nowatchdog( |")/\1\2/; s/  +/ /g; s/ "$/"/ }' "$tmp"
    fi
    if ! sudo cmp -s "$tmp" /etc/default/limine; then
        sudo test -e /etc/default/limine.bak-chezmoi || sudo cp -a /etc/default/limine /etc/default/limine.bak-chezmoi
        sudo install -m 0644 -o root -g root "$tmp" /etc/default/limine
        changed+=("/etc/default/limine")
        if has limine-update; then
            say "rebuilding boot entries (limine-update)"
            sudo limine-update || warn "limine-update failed; restore /etc/default/limine.bak-chezmoi if needed"
        fi
        reboot+=("kernel command line")
    fi
    rm -f "$tmp"
else
    skipped+=("kernel command line: /etc/default/limine not found (not a limine system)")
fi

# ---------------------------------------------------------------- services
sudo systemctl daemon-reload
[ "$HAS_BLUETOOTH" = true ] && { enable_unit bluetooth.service || true; }
enable_unit power-profiles-daemon.service --now || true
[ "$CPU_SENSOR" = k10temp ] && { enable_unit thermal-guard.service --now || true; }
if [ "$IS_AMD_LAPTOP" = true ] && has ryzenadj; then
    enable_unit ryzenadj.service || true
    enable_unit ryzenadj.timer --now || true
fi
[ "$watchdog_ok" = true ] && { enable_unit watchdog-suspend.service || true; }
[ "$HAS_BATTERY" = true ] && { enable_unit battery-care.service || true; }
has autorandr && { enable_unit autorandr.service || true; }
# Boot speed: nothing here needs to wait for the network at boot.
if systemctl is-enabled --quiet NetworkManager-wait-online.service 2>/dev/null; then
    sudo systemctl disable NetworkManager-wait-online.service >/dev/null 2>&1 && enabled+=("-NetworkManager-wait-online (disabled)")
fi
# Docker: start on first use (socket) instead of at boot.
if systemctl cat docker.socket >/dev/null 2>&1; then
    if systemctl is-enabled --quiet docker.service 2>/dev/null; then
        sudo systemctl disable docker.service >/dev/null 2>&1 && enabled+=("-docker.service (disabled)")
    fi
    enable_unit docker.socket || true
fi

# ---------------------------------------------------------------- summary
say "system configuration summary"
if [ "${#changed[@]}" -gt 0 ]; then printf '  written:  %s\n' "${changed[@]}"; else echo "  written:  nothing (already up to date)"; fi
[ "${#enabled[@]}" -gt 0 ] && printf '  units:    %s\n' "${enabled[@]}"
[ "${#skipped[@]}" -gt 0 ] && printf '  skipped:  %s\n' "${skipped[@]}"
if [ "${#reboot[@]}" -gt 0 ]; then
    printf '\033[1;33m  reboot needed for:\033[0m\n'
    printf '    - %s\n' "${reboot[@]}" | sort -u
fi
echo "  backups:  <file>.bak-chezmoi next to each replaced file"
exit 0
