#!/bin/bash
# Display toggle script - cycles through modes like Windows+P
# Modes: laptop-only → extend-right → mirror → tv-only → laptop-only

switch_audio_hdmi() {
    HDMI_CARD="alsa_card.pci-0000_03_00.1"
    pactl set-card-profile "$HDMI_CARD" HiFi 2>/dev/null
    sleep 0.3
    HDMI_SINK=$(pactl list sinks short | grep "pci-0000_03_00.1" | awk '{print $2}' | head -1)
    [ -n "$HDMI_SINK" ] && pactl set-default-sink "$HDMI_SINK"
}

switch_audio_speaker() {
    HDMI_CARD="alsa_card.pci-0000_03_00.1"
    pactl set-card-profile "$HDMI_CARD" off 2>/dev/null
    SPEAKER_SINK=$(pactl list sinks short | grep "pci-0000_03_00.6" | awk '{print $2}' | head -1)
    [ -n "$SPEAKER_SINK" ] && pactl set-default-sink "$SPEAKER_SINK"
}

# The layout cycle is in the displays script, which reports the new layout.
layout=$("$HOME/.config/sway/scripts/displays" cycle) || exit 0
case "$layout" in
    laptop) switch_audio_speaker ;;
    "") ;;
    *) switch_audio_hdmi ;;
esac
