#!/bin/bash
# drive-sync: hardened rclone bisync of Google Drive remotes into local folders.
#
# Remotes are machine-local and NOT part of the dotfiles repo. Configure them in
#   ~/.config/drive-sync/remotes.conf   (see remotes.conf.example next to it)
# one per line:  name|rclone-remote:|local folder|label   (label optional, ~ and $HOME allowed)
# Without that file the script exits 0 and does nothing.
#
# Usage:
#   drive-sync [TARGET]            normal bisync (TARGET: all or a name from remotes.conf)
#   drive-sync --dry-run [TARGET]  show what would change, touch nothing ("Verify now")
#   drive-sync --force [TARGET]    bypass the --max-delete safety abort (after checking!)
#   drive-sync --resync [TARGET]   rebuild bisync baseline (union copy, newer wins, no deletes)
#
# Behaviour:
#   - Skips gracefully (exit 0, state=offline) when there is no network / airplane mode.
#   - Skips timer runs when on battery below DRIVE_SYNC_MIN_BATTERY percent (default 10).
#   - Never runs --resync on its own: when rclone says "Must run --resync" the remote is
#     marked needs-resync and a desktop notification is sent. Use the polybar menu
#     (drive-sync-status --click) or `drive-sync --resync <target>` to recover.
#   - Per-remote status in ~/.local/state/drive-sync/<name>.status (read by drive-sync-status).
#   - Full verbose log of the last run per remote: ~/.local/state/drive-sync/<name>.last.log
#     (dry-runs: <name>.dryrun.log, result in <name>.verify).
#   - Per-run evidence (counts + changed paths) as JSON: ~/.local/state/drive-sync/runs/
#     (newest 30 per remote; <name>.last.json = latest, <name>.last-change.json = latest with changes).
#   - Live progress while running: $XDG_RUNTIME_DIR/drive-sync/progress (key=value).
#   - When $XDG_RUNTIME_DIR/drive-sync/notify-when-done exists (created by "Sync now"),
#     a summary notification is shown at the end of the run.
#   - Summary log: ~/.local/share/rclone/bisync.log (rotated at 2 MiB, one gzip generation).
#   - Files overwritten/deleted locally by a sync are kept 14 days in
#     ~/.local/share/drive-sync/backup/<name>/<date>/ (remote side uses Drive's trash).

set -u
export LC_ALL=C.UTF-8
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus}"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/drive-sync"
RUNS_DIR="$STATE_DIR/runs"
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/drive-sync"
PROGRESS="$RUN_DIR/progress"
NOTIFY_FLAG="$RUN_DIR/notify-when-done"
LOGFILE="$HOME/.local/share/rclone/bisync.log"
FILTERS="$HOME/.config/rclone/bisync-filters.txt"
BACKUP_ROOT="$HOME/.local/share/drive-sync/backup"
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/drive-sync-${UID}.lock"
LOG_MAX_BYTES=$((2 * 1024 * 1024))
BACKUP_KEEP_DAYS=14
RUNS_KEEP=30
RENOTIFY_SECONDS=$((6 * 3600))
MIN_BATTERY="${DRIVE_SYNC_MIN_BATTERY:-10}"

REMOTES_CONF="${DRIVE_SYNC_REMOTES:-${XDG_CONFIG_HOME:-$HOME/.config}/drive-sync/remotes.conf}"

# Load "name|remote|local dir" entries from remotes.conf (comments and blank lines ignored).
REMOTES=()
if [ -r "$REMOTES_CONF" ]; then
    while IFS='|' read -r r_name r_remote r_dir _; do
        case "$r_name" in ''|'#'*) continue ;; esac
        [ -n "$r_remote" ] && [ -n "$r_dir" ] || continue
        case "$r_dir" in
            \~) r_dir=$HOME ;;
            \~/*) r_dir="$HOME/${r_dir#\~/}" ;;
            \$HOME*) r_dir="$HOME${r_dir#\$HOME}" ;;
        esac
        REMOTES+=("$r_name|$r_remote|$r_dir")
    done <"$REMOTES_CONF"
fi
if [ "${#REMOTES[@]}" -eq 0 ]; then
    echo "drive-sync: no remotes configured in $REMOTES_CONF; nothing to do"
    exit 0
fi

known_target() { # name -> 0 if it is configured
    local entry
    for entry in "${REMOTES[@]}"; do [ "${entry%%|*}" = "$1" ] && return 0; done
    return 1
}

MODE=normal
TARGET=all
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) MODE=dry-run ;;
        --force) MODE=force ;;
        --resync) MODE=resync ;;
        -h|--help) sed -n '2,32p' "$0"; exit 0 ;;
        all) TARGET=all ;;
        -*) echo "Usage: drive-sync [--dry-run|--force|--resync] [all|NAME]" >&2; exit 2 ;;
        *)
            if known_target "$1"; then TARGET=$1
            else echo "drive-sync: unknown remote '$1' (see $REMOTES_CONF)" >&2; exit 2; fi ;;
    esac
    shift
done

mkdir -p "$STATE_DIR" "$RUNS_DIR" "$RUN_DIR" "$(dirname "$LOGFILE")" "$BACKUP_ROOT"

exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "[$(date '+%F %T')] Sync already in progress; skipping this run"
    exit 0
fi

log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOGFILE"; }

notify() { # urgency title body
    command -v notify-send >/dev/null 2>&1 || return 0
    # Linger is on, so the timer can fire before anyone logs in to X: do not
    # D-Bus-activate dunst without a display (it would fail and show as a failed unit).
    pgrep -u "$(id -u)" -x dunst >/dev/null || pgrep -u "$(id -u)" -x i3 >/dev/null || return 0
    notify-send -a "Drive sync" -u "$1" -i folder-cloud "$2" "$3" 2>/dev/null || true
}

# Wake the polybar tail (drive-sync-status --tail) so it redraws right away.
refresh_bar() { pkill -USR1 -f '^[^ ]*bash [^ ]*/drive-sync-status --tail$' 2>/dev/null || true; }

rotate_log() {
    local size
    size=$(stat -c %s "$LOGFILE" 2>/dev/null || echo 0)
    if [ "$size" -gt "$LOG_MAX_BYTES" ]; then
        gzip -c "$LOGFILE" >"$LOGFILE.1.gz" && : >"$LOGFILE"
    fi
}

fmt_duration() { # seconds -> "1m04s" / "12s"
    local s="${1:-0}"
    if [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60)); else printf '%ds' "$s"; fi
}

# Read one key from a status file (key=value lines).
status_get() { # file key
    [ -f "$1" ] || return 0
    local k v
    while IFS='=' read -r k v; do
        [ "$k" = "$2" ] && { printf '%s' "$v"; return 0; }
    done <"$1"
}

# Write status atomically. Keeps last_ok / notified_* unless overridden.
write_status() { # name state message [last_ok]
    local file="$STATE_DIR/$1.status" now last_ok notified_state notified_at
    now=$(date +%s)
    last_ok="${4:-$(status_get "$file" last_ok)}"
    notified_state=$(status_get "$file" notified_state)
    notified_at=$(status_get "$file" notified_at)
    {
        echo "state=$2"
        echo "message=${3//$'\n'/ }"
        echo "last_run=$now"
        echo "last_ok=${last_ok:-0}"
        echo "notified_state=${notified_state}"
        echo "notified_at=${notified_at:-0}"
    } >"$file.tmp" && mv -f "$file.tmp" "$file"
}

# Remote-side pending changes (Drive -> local) with the time they were measured.
write_remote_pending() { # name new modified deleted source
    local file="$STATE_DIR/$1.remote"
    printf 'checked_at=%s\nnew=%s\nmodified=%s\ndeleted=%s\nsource=%s\n' \
        "$(date +%s)" "$2" "$3" "$4" "$5" >"$file.tmp" && mv -f "$file.tmp" "$file"
}

# Notify only on state transitions, or again after RENOTIFY_SECONDS.
notify_once() { # name state urgency title body
    local file="$STATE_DIR/$1.status" prev_state prev_at now
    prev_state=$(status_get "$file" notified_state)
    prev_at=$(status_get "$file" notified_at)
    now=$(date +%s)
    if [ "$prev_state" != "$2" ] || [ $((now - ${prev_at:-0})) -gt "$RENOTIFY_SECONDS" ]; then
        notify "$3" "$4" "$5"
        sd '^notified_state=.*$' "notified_state=$2" "$file" 2>/dev/null
        sd '^notified_at=.*$' "notified_at=$now" "$file" 2>/dev/null
    fi
}

clear_notified() { # name
    local file="$STATE_DIR/$1.status"
    [ -f "$file" ] || return 0
    sd '^notified_state=.*$' 'notified_state=' "$file" 2>/dev/null
}

is_online() {
    if command -v nmcli >/dev/null 2>&1; then
        case "$(nmcli -t -f CONNECTIVITY general 2>/dev/null)" in
            none) return 1 ;;
        esac
    fi
    # Any HTTP answer (401 is expected without a token) means Google APIs are reachable.
    local code
    code=$(curl -s -o /dev/null --max-time 10 -w '%{http_code}' https://www.googleapis.com/drive/v3/about 2>/dev/null)
    [ -n "$code" ] && [ "$code" != "000" ]
}

battery_too_low() {
    local bat status cap
    for bat in /sys/class/power_supply/BAT*; do
        [ -r "$bat/status" ] || continue
        status=$(<"$bat/status")
        cap=$(<"$bat/capacity")
        [ "$status" = "Discharging" ] && [ "$cap" -lt "$MIN_BATTERY" ] && return 0
    done
    return 1
}

list_conflicts() { # local_dir
    fd -H -t f --no-ignore 'conflict[0-9]+' "$1" 2>/dev/null | sort
}

# --- live progress ---------------------------------------------------------------
# Phase from bisync INFO lines, bytes/percent/ETA from the one-line NOTICE stats
# (--stats 1s --stats-one-line), file counts from queued vs copied lines.
# shellcheck disable=SC2016 # awk program, not shell
PROGRESS_AWK='
/Building Path1 and Path2 listings/ { ph = "listing" }
/Path[12] checking for diffs/       { ph = "comparing" }
/Applying changes/                  { ph = "applying" }
/Do queued copies to/               { ph = "copying" }
/Updating listings/                 { ph = "finishing" }
/Queue copy to Path[12] /           { q++ }
/INFO  : .*: Copied \(/             { c++ }
/NOTICE: +[0-9.]+ ?[KMGTPE]?i?B \/ / {
    if (match($0, /NOTICE: +([0-9.]+ ?[KMGTPE]?i?B) \/ ([0-9.]+ ?[KMGTPE]?i?B), ([0-9]+%|-), ([^,]*), ETA (.*)$/, m)) {
        bd = m[1]; bt = m[2]; pct = m[3]; sp = m[4]; eta = m[5]; sub(/ *\(xfr#.*$/, "", eta)
    }
}
END {
    sub(/%$/, "", pct); if (pct == "-") pct = ""
    if (bt ~ /^0 ?B$/) pct = ""
    printf "%s|%s|%s|%s|%s|%s|%d|%d\n", ph, pct, bd, bt, sp, eta, q, c
}'

write_progress() { # name index total runlog started
    local phase pct bdone btotal speed eta queued copied
    IFS='|' read -r phase pct bdone btotal speed eta queued copied \
        < <(awk "$PROGRESS_AWK" "$4" 2>/dev/null)
    {
        printf 'remote=%s\nindex=%s\ntotal=%s\nmode=%s\n' "$1" "$2" "$3" "$MODE"
        printf 'phase=%s\npercent=%s\nbytes_done=%s\nbytes_total=%s\n' "${phase:-starting}" "$pct" "$bdone" "$btotal"
        printf 'speed=%s\neta=%s\nfiles_total=%s\nfiles_done=%s\n' "$speed" "$eta" "${queued:-0}" "${copied:-0}"
        printf 'started=%s\nupdated=%s\n' "$5" "$(date +%s)"
    } >"$PROGRESS.tmp" && mv -f "$PROGRESS.tmp" "$PROGRESS"
}

# --- per-run evidence --------------------------------------------------------------
# Emits "kind<TAB>value" records from a bisync log:
#   down/up (copies Drive->local / local->Drive), del-local/del-drive, conflict,
#   renamed, copied, deleted (confirmations), bytes, p1/p2 (change summaries), nochange.
# shellcheck disable=SC2016 # awk program, not shell
SUMMARY_AWK='
function rel(p) {
    if (index(p, ld) == 1) p = substr(p, length(ld) + 1)
    else if (index(p, rm) == 1) { p = substr(p, length(rm) + 1); sub(/^\//, "", p) }
    return p
}
/- Path1 +Queue copy to Path2 +- /  { p = $0; sub(/.*Queue copy to Path2 +- /, "", p); print "down\t" rel(p); next }
/- Path2 +Queue copy to Path1 +- /  { p = $0; sub(/.*Queue copy to Path1 +- /, "", p); print "up\t" rel(p); next }
/- Path2 +Queue delete +- /         { p = $0; sub(/.*Queue delete +- /, "", p); print "del-local\t" rel(p); next }
/- Path1 +Queue delete +- /         { p = $0; sub(/.*Queue delete +- /, "", p); print "del-drive\t" rel(p); next }
/New or changed in both paths/      { p = $0; sub(/.*New or changed in both paths +- /, "", p); print "conflict\t" rel(p); next }
/renamed to/                        { print "renamed\t1"; next }
/INFO  : .*: Copied \(/             { print "copied\t1"; next }
/INFO  : .*: Deleted$/              { print "deleted\t1"; next }
/No changes found/                  { print "nochange\t1"; next }
/Path1: +[0-9]+ changes:/           { s = $0; sub(/.*Path1: +/, "", s); gsub(/  +/, " ", s); print "p1\t" s; next }
/Path2: +[0-9]+ changes:/           { s = $0; sub(/.*Path2: +/, "", s); gsub(/  +/, " ", s); print "p2\t" s; next }
/NOTICE: +[0-9.]+ ?[KMGTPE]?i?B \/ / { s = $0; sub(/.*NOTICE: +/, "", s); sub(/ \/.*/, "", s); bytes = s; next }
/^Transferred: +[0-9.]+ ?[KMGTPE]?i?B \/ / { s = $0; sub(/^Transferred: +/, "", s); sub(/ \/.*/, "", s); bytes = s; next }
END { if (bytes != "") print "bytes\t" bytes }'

# Writes runs/<ts>-<name>.json (+ <name>.last.json / .last-change.json); prints a
# one-line human summary ("↓3 ↑1 ✗0 · 12 MiB") on stdout.
record_run() { # name remote local_dir runlog rc state started ended
    local name="$1" remote="$2" local_dir="$3" runlog="$4" rc="$5" state="$6" started="$7" ended="$8"
    local json file
    json=$(awk -v ld="${local_dir%/}/" -v rm="$remote" "$SUMMARY_AWK" "$runlog" 2>/dev/null \
        | jq -R -s -c \
            --arg name "$name" --arg mode "$MODE" --arg state "$state" \
            --argjson rc "$rc" --argjson started "$started" --argjson ended "$ended" '
            [split("\n")[] | select(length > 0) | split("\t") | {k: .[0], v: (.[1:] | join("\t"))}] as $r
            | def list($k): [$r[] | select(.k == $k) | .v];
              def n($k): (list($k) | length);
            {
              name: $name, mode: $mode, result: $state, exit: $rc,
              started: $started, ended: $ended, duration: ($ended - $started),
              counts: {
                down: n("down"), up: n("up"), deleted_local: n("del-local"),
                deleted_drive: n("del-drive"), conflicts: n("conflict"), renamed: n("renamed"),
                copied: n("copied"), deleted: n("deleted")
              },
              bytes: ((list("bytes") | last) // "0 B"),
              path1: ((list("p1") | last) // null),
              path2: ((list("p2") | last) // null),
              no_changes: (n("nochange") > 0),
              changes: ([ $r[] | select(.k | IN("down", "up", "del-local", "del-drive", "conflict"))
                          | {dir: .k, path: .v} ] | .[:200])
            }') || return 0
    [ -n "$json" ] || return 0
    file="$RUNS_DIR/$(date -d "@$started" +%Y%m%d-%H%M%S)-$name.json"
    printf '%s\n' "$json" >"$file"
    cp -f "$file" "$STATE_DIR/$name.last.json"
    if [ "$(jq '.counts.down + .counts.up + .counts.deleted_local + .counts.deleted_drive + .counts.conflicts' <<<"$json")" -gt 0 ]; then
        cp -f "$file" "$STATE_DIR/$name.last-change.json"
    fi
    # Retention: newest RUNS_KEEP runs per remote.
    fd -t f -g "*-$name.json" "$RUNS_DIR" 2>/dev/null | sort -r | tail -n +$((RUNS_KEEP + 1)) \
        | while IFS= read -r old; do rm -f -- "$old"; done
    jq -r '.counts as $c
        | (if ($c.down + $c.up + $c.deleted_local + $c.deleted_drive + $c.conflicts) == 0 then "no changes"
           else "↓\($c.down) ↑\($c.up) del \($c.deleted_local + $c.deleted_drive)"
                + (if $c.conflicts > 0 then " conflicts \($c.conflicts)" else "" end)
                + " · \(.bytes)" end)' <<<"$json"
}

# Parse "Path1: 3 changes: 3 new, 0 modified, 0 deleted" into "new mod del".
change_counts() { # "summary string"
    local s="${1:-}" new=0 mod=0 del=0
    [[ $s =~ ([0-9]+)\ new ]] && new=${BASH_REMATCH[1]}
    [[ $s =~ ([0-9]+)\ modified ]] && mod=${BASH_REMATCH[1]}
    [[ $s =~ ([0-9]+)\ deleted ]] && del=${BASH_REMATCH[1]}
    echo "$new $mod $del"
}

RCLONE_PID=""
# shellcheck disable=SC2329 # invoked by the EXIT trap
cleanup() {
    [ -n "$RCLONE_PID" ] && kill "$RCLONE_PID" 2>/dev/null
    rm -f "$PROGRESS" "$PROGRESS.tmp"
    refresh_bar
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

SUMMARY=()   # per-remote lines for the "Sync now" notification

sync_remote() { # name remote local_dir index total
    local name="$1" remote="$2" local_dir="$3" index="$4" total="$5"
    local runlog="$STATE_DIR/$name.last.log" backup_dir rc before after new_conflicts started ended human
    backup_dir="$BACKUP_ROOT/$name/$(date +%F)"
    [ "$MODE" = dry-run ] && runlog="$STATE_DIR/$name.dryrun.log"

    if [ ! -d "$local_dir" ]; then
        write_status "$name" error "Local folder missing: $local_dir"
        notify_once "$name" error critical "Drive sync: $name" "Local folder missing: $local_dir"
        log "✗ $name: local folder missing ($local_dir)"
        SUMMARY+=("✗ $name: local folder missing")
        return 1
    fi

    local args=(
        "$remote" "$local_dir"
        --filters-file "$FILTERS"
        --check-access
        --conflict-resolve newer
        --conflict-loser num
        --resilient
        --recover
        --max-lock 2m
        --max-delete 30
        --retries 3 --retries-sleep 10s
        --low-level-retries 10
        --contimeout 30s --timeout 5m
        --stats 1s --stats-one-line --stats-log-level NOTICE
        --color NEVER
        -v
    )
    case "$MODE" in
        dry-run) args+=(--dry-run) ;;
        force) args+=(--force --backup-dir2 "$backup_dir") ;;
        resync) args+=(--resync --resync-mode newer) ;;
        normal) args+=(--backup-dir2 "$backup_dir") ;;
    esac

    log "Syncing $name ($MODE)..."
    before=$(list_conflicts "$local_dir")
    started=$(date +%s)
    : >"$runlog"
    write_progress "$name" "$index" "$total" "$runlog" "$started"
    refresh_bar
    rclone bisync "${args[@]}" >"$runlog" 2>&1 &
    RCLONE_PID=$!
    while kill -0 "$RCLONE_PID" 2>/dev/null; do
        write_progress "$name" "$index" "$total" "$runlog" "$started"
        sleep 1
    done
    wait "$RCLONE_PID"
    rc=$?
    RCLONE_PID=""
    ended=$(date +%s)
    # Keep errors/notices in the long-lived log (not the per-second stats lines).
    rg -N '(ERROR|NOTICE)' "$runlog" \
        | rg -v 'shared Google Drive client_id|NOTICE: +[0-9.]+ ?[KMGTPE]?i?B / ' | tail -n 40 >>"$LOGFILE"
    # rclone's shared OAuth client is rate limited and being retired: remember it for the menu.
    if rg -q 'shared Google Drive client_id' "$runlog"; then
        : >"$STATE_DIR/$name.shared-client-id"
    else
        rm -f "$STATE_DIR/$name.shared-client-id"
    fi

    if [ "$MODE" = dry-run ]; then
        local p1 p2 result
        p1=$(rg -o 'Path1: +[0-9]+ changes:.*' "$runlog" | tail -n 1 | tr -s ' ')
        p2=$(rg -o 'Path2: +[0-9]+ changes:.*' "$runlog" | tail -n 1 | tr -s ' ')
        if [ "$rc" -ne 0 ]; then result=error
        elif [ -z "$p1$p2" ]; then result=in-sync
        else result=differs; fi
        printf 'checked_at=%s\nresult=%s\nexit=%s\npath1=%s\npath2=%s\nduration=%s\n' \
            "$ended" "$result" "$rc" "$p1" "$p2" "$((ended - started))" >"$STATE_DIR/$name.verify"
        if [ "$rc" -eq 0 ]; then
            # Path1 = Drive: exact remote-side pending counts.
            # shellcheck disable=SC2046 # three numbers, split on purpose
            write_remote_pending "$name" $(change_counts "$p1") verify
        fi
        case "$result" in
            in-sync) SUMMARY+=("✓ $name: in sync") ;;
            differs) SUMMARY+=("≠ $name: Drive ${p1:-no changes}; local ${p2:-no changes}") ;;
            *) SUMMARY+=("✗ $name: dry-run failed (exit $rc)") ;;
        esac
        log "dry-run $name finished (exit $rc, $result); full output: $runlog"
        return "$rc"
    fi

    if [ "$rc" -eq 0 ]; then
        after=$(list_conflicts "$local_dir")
        new_conflicts=$(comm -13 <(printf '%s\n' "$before") <(printf '%s\n' "$after") | rg -c . || true)
        write_status "$name" ok "Synced" "$(date +%s)"
        clear_notified "$name"
        write_remote_pending "$name" 0 0 0 sync
        rm -f "$RUN_DIR/$name.local"   # local pending cache
        human=$(record_run "$name" "$remote" "$local_dir" "$runlog" "$rc" ok "$started" "$ended")
        if [ "${new_conflicts:-0}" -gt 0 ]; then
            notify normal "Drive sync: $name conflicts" \
                "$new_conflicts file(s) changed on both sides. Newer kept; older renamed *.conflictN in $local_dir"
            log "⚠ $name: $new_conflicts new conflict file(s)"
        fi
        log "✓ $name synced successfully in $(fmt_duration $((ended - started))): ${human:-no summary}"
        SUMMARY+=("✓ $name: ${human:-synced} ($(fmt_duration $((ended - started))))")
        return 0
    fi

    # Classify the failure.
    local state=error urgency=critical msg
    if rg -qi 'must run --resync' "$runlog"; then
        state=needs-resync
        msg="Bisync baseline lost. Review, then use 'Resync' in the Drive menu."
    elif rg -qi 'too many deletes|safety abort' "$runlog"; then
        state=too-many-deletes
        msg="Too many deletions detected; aborted for safety. Check, then run: drive-sync --force $name"
    elif rg -qi 'invalid_grant|couldn.t fetch token|token expired|oauth2|unauthorized_client|401 Unauthorized' "$runlog"; then
        state=auth
        msg="Google auth expired. Run: rclone config reconnect $remote"
    elif rg -qi 'network is unreachable|no such host|i/o timeout|connection refused|connection reset|TLS handshake timeout|dial tcp' "$runlog"; then
        state=offline
        urgency=low
        msg="Network dropped during sync; will retry."
    elif rg -qi 'rateLimitExceeded|userRateLimitExceeded|code 429|quotaExceeded' "$runlog"; then
        state=rate-limited
        urgency=low
        msg="Google API rate limit; will retry next run."
    elif rg -qi 'prior lock file found' "$runlog"; then
        state=locked
        urgency=low
        msg="Stale bisync lock; expires automatically (--max-lock 2m)."
    else
        msg="$(rg -i 'error' "$runlog" | tail -n 1 | cut -c1-160)"
        [ -n "$msg" ] || msg="rclone exit $rc"
    fi
    write_status "$name" "$state" "$msg"
    record_run "$name" "$remote" "$local_dir" "$runlog" "$rc" "$state" "$started" "$ended" >/dev/null
    case "$state" in
        offline|rate-limited|locked) ;; # transient: no popup
        *) notify_once "$name" "$state" "$urgency" "Drive sync failed: $name" "$msg" ;;
    esac
    log "✗ $name sync failed (exit $rc, $state): $msg"
    SUMMARY+=("✗ $name: $state - $msg")
    case "$state" in
        offline|rate-limited|locked) return 0 ;; # transient: retried next run
    esac
    return "$rc"
}

# "Sync now" / "Verify now" asked for a summary notification when this run ends.
notify_summary() { # exit_code elapsed
    [ -e "$NOTIFY_FLAG" ] || return 0
    rm -f "$NOTIFY_FLAG"
    local title urgency=normal
    if [ "$MODE" = dry-run ]; then title="Drive verify finished"
    elif [ "$1" -eq 0 ]; then title="Drive sync finished"
    else title="Drive sync failed"; urgency=critical; fi
    notify "$urgency" "$title ($(fmt_duration "$2"))" "$(printf '%s\n' "${SUMMARY[@]}")"
}

rotate_log

# Prune old local backups.
fd -t d --min-depth 2 --max-depth 2 --changed-before "${BACKUP_KEEP_DAYS}d" . "$BACKUP_ROOT" -x rm -rf -- {} 2>/dev/null

if [ "$MODE" = normal ] && [ -n "${DRIVE_SYNC_TIMER:-}" ] && battery_too_low; then
    log "Battery below ${MIN_BATTERY}% and discharging; skipping timer run"
    SUMMARY+=("Skipped: battery below ${MIN_BATTERY}%")
    notify_summary 0 0
    exit 0
fi

if ! is_online; then
    log "Offline (no route to Google APIs); skipping"
    for entry in "${REMOTES[@]}"; do
        IFS='|' read -r name _ _ <<<"$entry"
        [ "$TARGET" = all ] || [ "$TARGET" = "$name" ] || continue
        write_status "$name" offline "No network"
    done
    SUMMARY+=("Skipped: offline (no route to Google APIs)")
    notify_summary 0 0
    exit 0
fi

selected=()
for entry in "${REMOTES[@]}"; do
    [ "$TARGET" = all ] || [ "$TARGET" = "${entry%%|*}" ] || continue
    selected+=("$entry")
done

exit_code=0
run_start=$(date +%s)
i=0
for entry in "${selected[@]}"; do
    i=$((i + 1))
    IFS='|' read -r name remote local_dir <<<"$entry"
    sync_remote "$name" "$remote" "$local_dir" "$i" "${#selected[@]}" || exit_code=1
done

notify_summary "$exit_code" $(( $(date +%s) - run_start ))
exit "$exit_code"
