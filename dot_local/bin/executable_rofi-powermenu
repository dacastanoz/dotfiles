#!/usr/bin/env bash
# Power menu: lock, logout (i3), suspend, reboot, shutdown.
# Dangerous actions ask for confirmation.
set -u

menu() {
    rofi -dmenu -i -no-custom -show-icons -p "$1" -theme-str 'window { width: 320px; } listview { lines: 5; }'
}

confirm() {
    local answer
    answer=$(printf 'No\0icon\x1fdialog-cancel\nYes\0icon\x1fdialog-ok\n' | menu "$1?")
    [ "$answer" = "Yes" ]
}

choice=$(printf '%b' \
    'Lock\0icon\x1fsystem-lock-screen\n' \
    'Logout\0icon\x1fsystem-log-out\n' \
    'Suspend\0icon\x1fsystem-suspend\n' \
    'Reboot\0icon\x1fsystem-reboot\n' \
    'Shutdown\0icon\x1fsystem-shutdown\n' | menu "Power")

case "$choice" in
    Lock)     sleep 0.2; i3lock --blur 5 ;;
    Logout)   confirm "Log out" && i3-msg exit ;;
    Suspend)  confirm "Suspend" && { sleep 0.2; i3lock --blur 5 & systemctl suspend; } ;;
    Reboot)   confirm "Reboot" && systemctl reboot ;;
    Shutdown) confirm "Shut down" && systemctl poweroff ;;
    *)        exit 0 ;;
esac
